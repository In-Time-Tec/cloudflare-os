{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    // DOM for the Web fetch types (Response, Headers); the library runs on Workers
    // and Node >= 18, both of which provide the same global fetch surface.
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler"
  },
  "include": ["src", "__tests__"],
  "exclude": ["dist", "node_modules"]
}
