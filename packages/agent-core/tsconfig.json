{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "esnext",
      "ESNext.Disposable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types/experimental"],
    "noEmit": true,
    "paths": {
      "@gadgets/workshop-shared/*": [
        "../workshop-shared/src/*"
      ],
      "@gadgets/backend-utils/*": [
        "../backend-utils/src/*"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
