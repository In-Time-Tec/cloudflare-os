{
  // Stable Worker names preserve service identity and Durable Object state across releases.
  "workers": {
    "router": "intimetec-cloudflare-os",
    "backend": "intimetec-cloudflare-os-backend",
    "context": "intimetec-cloudflare-os-context",
    "scheduler": "intimetec-cloudflare-os-scheduler"
  },

  // Temporary built-in password authentication. Entra ID will replace this in Phase 1.
  "auth": {
    "admins": ["dallenpyrah"]
  },

  "context": {
    "sharingDomain": "intimetec-workers-dev"
  },

  // One backend-only OpenRouter credential funds these curated models for every user.
  "ai": {
    "providers": ["openrouter"],
    "defaultModel": "openai/gpt-5.6-luna"
  },

  // Stable names let stateless CI reconnect storage after retries and partial deployments.
  "resources": {
    "blueprintsKvNamespace": "intimetec-cloudflare-os-backend-blueprints",
    "avatarsKvNamespace": "intimetec-cloudflare-os-backend-avatars",
    "blueprintContentBucket": "intimetec-cloudflare-os-backend-blueprint-content",
    "contextKvNamespace": "intimetec-cloudflare-os-context-context-collections"
  }
}
